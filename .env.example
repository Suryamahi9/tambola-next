# Member-only access (copy to .env.local and fill in)
#
# The first admin account is created automatically on first run from these:
ADMIN_EMAIL=admin@tambola.local
ADMIN_PASSWORD=change-me

# Vercel deploy (recommended setup):
#   1. Create a PRIVATE Blob store in the Vercel dashboard and connect it to
#      this project. Vercel then injects BLOB_READ_WRITE_TOKEN automatically;
#      copy it here too if you want the same store when running locally.
#      With the blob connected, members + sessions persist across redeploys.
#   2. Add ADMIN_EMAIL / ADMIN_PASSWORD (and AUTH_SECRET, COOKIE_SECURE=true)
#      as project env vars in the Vercel dashboard. .env.local is NOT uploaded.
# BLOB_READ_WRITE_TOKEN=
# AUTH_SECRET=32+ random characters
# COOKIE_SECURE=true

# Party Rooms (Razorpay)
# Without these keys the room flow runs in TEST MODE: "Pay" auto-approves so
# you can try the multiplayer room end-to-end for free.
# With keys set (use Razorpay dashboard TEST keys), checkout opens and payments
# are verified server-side. Room price defaults to ₹20/ticket; override with
# ROOM_TICKET_PRICE (INR, e.g. 20 or 25.5).
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# ROOM_TICKET_PRICE=20
