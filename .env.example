# Member-only access (copy to .env.local and fill in)
#
# AUTH_SECRET   Session signing key. If unset, a random key is generated and
#               stored in data/secret on first run (note: sessions invalidate
#               if data/ is deleted).
# COOKIE_SECURE  Set to "true" only when serving over HTTPS.
#
# The first admin account is created automatically on first run from these:
ADMIN_EMAIL=admin@tambola.local
ADMIN_PASSWORD=change-me

# Optional: pin AUTH_SECRET across deploys
# AUTH_SECRET=32+ random characters
# COOKIE_SECURE=false
